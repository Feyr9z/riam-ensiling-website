# =========================================
# Riam Ensiling — Environment Variables
# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed (already in .gitignore).
# =========================================

# --- Database ---
# MySQL connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@127.0.0.1:3307/riam_ensiling"

# --- App ---
# Public base URL of the app (used for callback/redirect URLs, absolute links, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Admin Auth ---
# Long, random string used to sign/encrypt the admin session cookie.
# Generate one locally, e.g.: openssl rand -base64 32
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# --- Booking ---
# Minutes a Pending (unpaid) booking is held before it auto-expires
# and releases its gazebo/date slot.
BOOKING_EXPIRY_MINUTES=60

# --- Midtrans Sandbox + Snap + QRIS ---
# Get these from your Midtrans Sandbox dashboard (https://dashboard.sandbox.midtrans.com).
# Never use production keys in this project.
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=false

# --- MySQL container credentials (used by docker-compose.yml) ---
# Keep these in sync with the values embedded in DATABASE_URL above.
MYSQL_ROOT_PASSWORD="password"
MYSQL_DATABASE="riam_ensiling"
MYSQL_USER="riam_user"
MYSQL_PASSWORD="password"
