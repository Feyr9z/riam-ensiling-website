# ============================================================
# Riam Ensiling — Dockerfile.dev (Development)
#
# Runs the Next.js dev server with hot reload.
# Source code is mounted as a volume from the host.
# ============================================================

FROM node:22-alpine
WORKDIR /app

# Install dependencies first (layer cached until package.json changes)
COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["npm", "run", "dev"]
